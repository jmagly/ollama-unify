#!/usr/bin/env python3
import http.server
import json
import os
import signal
import socket
import sys
import threading
import time


def emit(kind, **fields):
    path = os.environ.get("MOCK_OLLAMA_EVENT_LOG")
    if not path:
        return
    record = {"kind": kind, "pid": os.getpid(), **fields}
    with open(path, "a", encoding="utf-8") as stream:
        stream.write(json.dumps(record, separators=(",", ":")) + "\n")


if sys.argv[1:] != ["serve"]:
    raise SystemExit(2)

host, port = os.environ.get("OLLAMA_HOST", "127.0.0.1:11434").rsplit(":", 1)
gpu = os.environ.get("CUDA_VISIBLE_DEVICES", "")
gpu_usage_dir = os.environ.get("MOCK_OLLAMA_GPU_USAGE_DIR", "")
gpu_usage_mib = int(os.environ.get("MOCK_OLLAMA_VRAM_MIB", "2048"))
gpu_usage_by_gpu = json.loads(os.environ.get("MOCK_OLLAMA_GPU_USAGE_BY_GPU", "{}"))
gpu_usage_scope = os.environ.get("MOCK_OLLAMA_GPU_USAGE_SCOPE", gpu).split(",")
cpu_only = os.environ.get("MOCK_OLLAMA_CPU_ONLY", "0") == "1"
partial_gpu_residency = os.environ.get("MOCK_OLLAMA_PARTIAL_GPU_RESIDENCY", "0") == "1"
context_length = int(os.environ.get("MOCK_OLLAMA_CONTEXT_LENGTH",
                                   os.environ.get("OLLAMA_CONTEXT_LENGTH", "0")) or "0")
model_digests = json.loads(os.environ.get("MOCK_OLLAMA_MODEL_DIGESTS", "{}"))
gpu_usage_path = (
    os.path.join(gpu_usage_dir, f"{os.getpid()}.csv") if gpu_usage_dir else ""
)


def set_gpu_usage(loaded):
    if not gpu_usage_path:
        return
    os.makedirs(gpu_usage_dir, exist_ok=True)
    if loaded:
        replacement = gpu_usage_path + ".new"
        with open(replacement, "w", encoding="utf-8") as stream:
            for gpu_uuid in gpu_usage_scope:
                if gpu_uuid:
                    amount = gpu_usage_by_gpu.get(gpu_uuid, gpu_usage_mib)
                    if int(amount) > 0:
                        stream.write(f"{gpu_uuid},{int(amount)}\n")
        os.replace(replacement, gpu_usage_path)
    else:
        try:
            os.unlink(gpu_usage_path)
        except FileNotFoundError:
            pass


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self):
        super().__init__((host, int(port)), Handler)
        self.models = []
        self.lock = threading.Lock()


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def send_json(self, payload, status=200, headers=None):
        data = json.dumps(payload, separators=(",", ":")).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        for key, value in (headers or {}).items():
            self.send_header(key, value)
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/api/version":
            self.send_json({"version": "fixture"})
        elif self.path == "/api/ps":
            with self.server.lock:
                models = list(self.server.models)
            self.send_json({"models": models})
        else:
            self.send_json({"error": "not found"}, 404)

    def do_POST(self):
        length = int(self.headers.get("Content-Length", "0") or "0")
        payload = json.loads(self.rfile.read(length) or b"{}")
        model = str(payload.get("model") or "")
        emit("request", host=f"{host}:{port}", gpu=gpu, path=self.path,
             model=model, request_id=payload.get("mock_request_id"),
             options=payload.get("options") or {}, keep_alive=payload.get("keep_alive"),
             has_authorization="Authorization" in self.headers,
             has_proxy_authorization="Proxy-Authorization" in self.headers,
             has_cookie="Cookie" in self.headers,
             input=payload.get("input"))
        barrier_requests = int(payload.get("mock_barrier_requests") or 0)
        if barrier_requests:
            deadline = time.monotonic() + 8
            while time.monotonic() < deadline:
                with open(os.environ["MOCK_OLLAMA_EVENT_LOG"], encoding="utf-8") as stream:
                    arrived = sum(
                        1 for event in map(json.loads, stream)
                        if event.get("kind") == "request"
                        and event.get("model") == model
                        and event.get("request_id") is not None
                    )
                if arrived >= barrier_requests:
                    break
                time.sleep(0.01)
            else:
                self.send_json({"error": "fixture parallel request barrier expired"}, 503)
                return
        if self.path == "/api/generate" and model.startswith("fixture-embed:"):
            self.send_json({"error": f"{model!r} does not support generate"}, 400)
            return
        if (self.path == "/api/generate"
                and model.startswith("fixture-reject:")
                and payload.get("mock_request_id") is None):
            time.sleep(0.15)
            self.send_json(
                {"error": f"{model!r} does not support requested operation"}, 400
            )
            return
        if (self.path == "/api/generate"
                and model.startswith("fixture-retry:")
                and payload.get("mock_request_id") is None):
            log_path = os.environ.get("MOCK_OLLAMA_EVENT_LOG")
            warm_count = 0
            if log_path and os.path.exists(log_path):
                with open(log_path, encoding="utf-8") as stream:
                    for line in stream:
                        event = json.loads(line)
                        if (event.get("kind") == "request"
                                and event.get("model") == model
                                and event.get("request_id") is None):
                            warm_count += 1
            if warm_count == 1:
                self.send_json({"error": "retry later"}, 429)
                return
        if payload.get("mock_backend_reset") is True:
            try:
                self.connection.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            self.connection.close()
            self.close_connection = True
            return
        if payload.get("mock_partial_stall") is True:
            partial = b'{"partial":true'
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(partial) + 128))
            self.end_headers()
            self.wfile.write(partial)
            self.wfile.flush()
            time.sleep(float(payload.get("mock_delay") or 0))
            try:
                self.connection.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            self.connection.close()
            self.close_connection = True
            return
        delay = float(payload.get("mock_delay") or 0)
        if delay > 0:
            time.sleep(delay)
        if payload.get("mock_stream") is True:
            chunk_count = max(1, int(payload.get("mock_stream_count") or 2))
            chunk_interval = max(
                0.0, float(payload.get("mock_stream_interval") or 0.02)
            )
            chunks = [
                json.dumps({
                    "message": f"chunk-{index + 1}",
                    "done": index + 1 == chunk_count,
                }, separators=(",", ":")).encode() + b"\n"
                for index in range(chunk_count)
            ]
            self.send_response(200)
            self.send_header("Content-Type", "application/x-ndjson")
            self.send_header(
                "X-Mock-Response", str(payload.get("mock_request_id") or "")
            )
            self.send_header("Connection", "close")
            self.end_headers()
            for chunk in chunks:
                self.wfile.write(chunk)
                self.wfile.flush()
                time.sleep(chunk_interval)
            self.close_connection = True
            return
        with self.server.lock:
            if payload.get("keep_alive") == 0:
                self.server.models = []
                set_gpu_usage(False)
            elif model:
                resident_bytes = sum(
                    int(gpu_usage_by_gpu.get(gpu_uuid, gpu_usage_mib))
                    for gpu_uuid in gpu_usage_scope if gpu_uuid
                ) * 1024 * 1024
                self.server.models = [{
                    "name": model,
                    "digest": model_digests.get(model),
                    "size": resident_bytes,
                    "size_vram": (0 if cpu_only else resident_bytes // 2
                                  if partial_gpu_residency else resident_bytes),
                    "context_length": context_length,
                }]
                set_gpu_usage(not cpu_only)
        response_payload = {
            "done": True, "model": model, "gpu": gpu, "pid": os.getpid(),
        }
        if self.path == "/api/embed":
            # Model residency is established above, matching native scheduleRunner
            # before its empty-input return. Empty setup never invokes embeddings.
            if payload.get("input") in (None, "", []):
                response_payload["embeddings"] = []
            else:
                emit("embedding_execution", model=model,
                     request_id=payload.get("mock_request_id"))
                response_payload["embeddings"] = [[0.25, 0.75]]
        mock_body_size = int(payload.get("mock_body_size") or 0)
        if mock_body_size > 0:
            response_payload["padding"] = "x" * mock_body_size
        self.send_json(
            response_payload,
            headers={
                "X-Mock-Response": str(payload.get("mock_request_id") or "")
            },
        )

    def log_message(self, _fmt, *_args):
        pass


server = Server()


def stop(_signum, _frame):
    threading.Thread(target=server.shutdown, daemon=True).start()


signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)
emit("start", host=f"{host}:{port}", gpu=gpu, ppid=os.getppid(),
     context_length=context_length,
     sched_spread=os.environ.get("OLLAMA_SCHED_SPREAD"),
     cuda_p2p=os.environ.get("GGML_CUDA_P2P"),
     unified_memory=os.environ.get("GGML_CUDA_ENABLE_UNIFIED_MEMORY"),
     no_pinned=os.environ.get("GGML_CUDA_NO_PINNED"))
try:
    server.serve_forever()
finally:
    server.server_close()
    set_gpu_usage(False)
    emit("stop", host=f"{host}:{port}", gpu=gpu)
